# Gym Plan — Supabase accounts and sync (PRD 5).
# Copy to .env (gitignored) and fill in:  cp .env.example .env
#
# Both values are PUBLIC by design. Vite compiles them into the JS bundle, and row-level
# security in Postgres is what protects the data. Leave them unset (or delete .env) for a
# keyless build: no sign-in UI, everything stays on the device, exactly like today.
#
# NEVER put any of these here or in any other tracked file. They live in the Supabase dashboard only:
#   - sb_secret_… / service_role key
#   - Google OAuth client secret
#   - Gmail app password (SMTP)
#   - Database password (entered at `supabase link`, held by the CLI)
#
# CI: the same two names are set as GitHub Actions *variables* (not secrets) and passed to
# the build in .github/workflows/deploy.yml.

# Supabase dashboard → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard → Project Settings → API Keys → Publishable key (starts sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
