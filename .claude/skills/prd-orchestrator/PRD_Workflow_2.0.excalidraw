    {
      "type": "text",
      "id": "a1_d",
      "x": 20,
      "y": 1062,
      "width": 331.2,
      "height": 75,
      "text": "WORKER agents can't git commit / push /\nreset --hard / rebase / clean -fd — even in\nbypass mode. Commits happen orchestrator-side:\nyou approve, or it commits if you opted in. Git's\npost-commit hook records the real SHA automatically.",
      "originalText": "WORKER agents can't git commit / push /\nreset --hard / rebase / clean -fd — even in\nbypass mode. Commits happen orchestrator-side:\nyou approve, or it commits if you opted in. Git's\npost-commit hook records the real SHA automatically.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "lineHeight": 1.25,
      "roughness": 0,
      "opacity": 100,
