    },
    {
      "type": "text",
      "id": "adv_b",
      "x": 1030,
      "y": 78,
      "width": 418.359375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 110022,
      "version": 39,
      "versionNonce": 134485031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788726181047,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 3,
      "text": "Fresh context per worker\n   -> a clean reviewer is an honest one; no rot.\nDurable on-disk ledger\n   -> survives crashes, restarts; resumes.\nDeterministic gates around the judgment\n   -> the model that raised a doubt can't grade it.\nONE review at the end, over the whole diff\n   -> cheaper & truer than reviewing each phase.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fresh context per worker\n   -> a clean reviewer is an honest one; no rot.\nDurable on-disk ledger\n   -> survives crashes, restarts; resumes.\nDeterministic gates around the judgment\n   -> the model that raised a doubt can't grade it.\nONE review at the end, over the whole diff\n   -> cheaper & truer than reviewing each phase.",
      "lineHeight": 1.25,
      "index": "a7",
      "autoResize": true
    },
