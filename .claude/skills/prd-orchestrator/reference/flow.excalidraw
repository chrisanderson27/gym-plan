      "locked": false,
      "fontSize": 11.695811491394357,
      "fontFamily": 3,
      "text": "One hub spawns a FRESH agent per stage, judges the artifact, advances a durable ledger.\nThe hub never writes feature code. State lives on disk, not in a context window - so the run survives crashes/restarts of the tooling.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One hub spawns a FRESH agent per stage, judges the artifact, advances a durable ledger.\nThe hub never writes feature code. State lives on disk, not in a context window - so the run survives crashes/restarts of the tooling.",
      "lineHeight": 1.25,
      "index": "a1",
      "autoResize": true
    },
