  {
   "type": "text",
   "id": "f_never_t",
   "x": 115,
   "y": 2626,
   "width": 1940,
   "height": 60,
   "text": "THE ONE THING AUTONOMY NEVER COVERS.  A run may commit code \u2014 code is gated by build, tests, e2e and review.\nIt may NEVER auto-commit the files that instruct agents: AGENTS.md, .claude/standards/**, CLAUDE.md, anything in always_loaded.\nThose are @-imported into every future session, so a wrong edit compounds forever \u2014 and no build, test or review would ever catch it.",
   "originalText": "THE ONE THING AUTONOMY NEVER COVERS.  A run may commit code \u2014 code is gated by build, tests, e2e and review.\nIt may NEVER auto-commit the files that instruct agents: AGENTS.md, .claude/standards/**, CLAUDE.md, anything in always_loaded.\nThose are @-imported into every future session, so a wrong edit compounds forever \u2014 and no build, test or review would ever catch it.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 600065,
   "version": 1,
   "versionNonce": 600066,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "g_head",
   "x": 2150,
   "y": 1900,
   "width": 1000,
   "height": 28,
   "text": "WHEN IT GOES QUIET \u2014 read this before you assume it is broken",
   "originalText": "WHEN IT GOES QUIET \u2014 read this before you assume it is broken",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700001,
   "version": 1,
   "versionNonce": 700002,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "g_sub",
   "x": 2150,
   "y": 1932,
   "width": 1150,
   "height": 22,
   "text": "Every one of these looks like SUCCESS from the outside. Check them in this order.",
   "originalText": "Every one of these looks like SUCCESS from the outside. Check them in this order.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700003,
   "version": 1,
   "versionNonce": 700004,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
