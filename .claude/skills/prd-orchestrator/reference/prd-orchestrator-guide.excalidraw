  },
  {
   "type": "text",
   "id": "b_code_c",
   "x": 830,
   "y": 900,
   "width": 600,
   "height": 56,
   "text": "This one file is the whole port. Tracked, so it survives `git worktree add`\nand every teammate gets it from the branch. Set `[budget].max_cost_usd = 50.0`\nto halt between phases when the running estimate crosses the ceiling.",
   "originalText": "This one file is the whole port. Tracked, so it survives `git worktree add`\nand every teammate gets it from the branch. Set `[budget].max_cost_usd = 50.0`\nto halt between phases when the running estimate crosses the ceiling.",
