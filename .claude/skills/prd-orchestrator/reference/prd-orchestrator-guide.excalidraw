   }
  },
  {
   "type": "text",
   "id": "g_1t",
   "x": 2170,
   "y": 1984,
   "width": 1110,
   "height": 95,
   "text": "1.  THE WORKER NEVER STARTED \u2014 by far the most common, and the most invisible\n     A fresh git worktree is an UNTRUSTED FOLDER. The agent shows a trust dialog defaulting to \"No, exit\",\n     then exits. The pane still reports ready and idle; the prompt still returns success. Nothing is ever written.\n     no --permission-mode covers this (folder trust is upstream).        FIX \u2192  orchestrator.py preflight --trust",
   "originalText": "1.  THE WORKER NEVER STARTED \u2014 by far the most common, and the most invisible\n     A fresh git worktree is an UNTRUSTED FOLDER. The agent shows a trust dialog defaulting to \"No, exit\",\n     then exits. The pane still reports ready and idle; the prompt still returns success. Nothing is ever written.\n     no --permission-mode covers this (folder trust is upstream).        FIX \u2192  orchestrator.py preflight --trust",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700007,
   "version": 1,
   "versionNonce": 700008,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "g_2",
   "x": 2150,
   "y": 2100,
   "width": 1150,
   "height": 86,
   "strokeColor": "#dc2626",
   "backgroundColor": "#fee2e2",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
