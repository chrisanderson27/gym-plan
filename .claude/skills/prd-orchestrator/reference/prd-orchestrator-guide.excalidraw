  },
  {
   "type": "text",
   "id": "e_dev_h",
   "x": 2150,
   "y": 1490,
   "width": 1000,
   "height": 25,
   "text": "WHAT COUNTS AS A DEVIATION \u2014 the bar is deliberately high",
   "originalText": "WHAT COUNTS AS A DEVIATION \u2014 the bar is deliberately high",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 500039,
   "version": 1,
   "versionNonce": 500040,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "e_dev_r",
   "x": 2150,
   "y": 1522,
   "width": 1150,
   "height": 80,
   "text": "A record is only allowed in if the agent can QUOTE THE PRD VERBATIM.  That one rule does all the work \u2014\nan ordinary implementation choice has no quote to produce, so it is absorbed silently and never reaches you.\n\nGate A  does it contradict / extend / reinterpret a quotable PRD line?      Gate B  blast radius \u2208 schema \u00b7 api-contract \u00b7 auth \u00b7 money \u00b7 data\nGate C  would a competent engineer reading only this diff agree in 2 min?   \u2192 then absorb it, however marginal Gate A felt.",
   "originalText": "A record is only allowed in if the agent can QUOTE THE PRD VERBATIM.  That one rule does all the work \u2014\nan ordinary implementation choice has no quote to produce, so it is absorbed silently and never reaches you.\n\nGate A  does it contradict / extend / reinterpret a quotable PRD line?      Gate B  blast radius \u2208 schema \u00b7 api-contract \u00b7 auth \u00b7 money \u00b7 data\nGate C  would a competent engineer reading only this diff agree in 2 min?   \u2192 then absorb it, however marginal Gate A felt.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 500041,
   "version": 1,
   "versionNonce": 500042,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "e_code",
   "x": 2150,
   "y": 1630,
   "width": 1150,
   "height": 190,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
