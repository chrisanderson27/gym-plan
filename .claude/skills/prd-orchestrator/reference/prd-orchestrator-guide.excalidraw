   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "g_1",
   "x": 2150,
   "y": 1970,
   "width": 1150,
   "height": 120,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fecaca",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700005,
   "version": 1,
   "versionNonce": 700006,
   "isDeleted": false,
   "groupIds": [],
