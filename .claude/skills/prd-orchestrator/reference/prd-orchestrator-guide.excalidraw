  {
   "type": "text",
   "id": "e_l7",
   "x": 2215,
   "y": 1410,
   "width": 900,
   "height": 22,
   "text": "deviations-<prd>.md   \u2605 THE FILE YOU ACTUALLY READ at the end",
   "originalText": "deviations-<prd>.md   \u2605 THE FILE YOU ACTUALLY READ at the end",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#047857",
