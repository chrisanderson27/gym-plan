  },
  {
   "type": "text",
   "id": "g_2t",
   "x": 2170,
   "y": 2114,
   "width": 1110,
   "height": 62,
   "text": "2.  THE PANE IS NOT LOGGED IN\n     Same silence, different cause: it answers \"Not logged in\", reports done in 0s, writes nothing.\n     Read the pane, authenticate, then re-split \u2014 the old agent name is dead.",
   "originalText": "2.  THE PANE IS NOT LOGGED IN\n     Same silence, different cause: it answers \"Not logged in\", reports done in 0s, writes nothing.\n     Read the pane, authenticate, then re-split \u2014 the old agent name is dead.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700011,
   "version": 1,
   "versionNonce": 700012,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "g_3",
   "x": 2150,
   "y": 2196,
   "width": 1150,
   "height": 86,
   "strokeColor": "#b45309",
   "backgroundColor": "#fef3c7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 700013,
   "version": 1,
   "versionNonce": 700014,
   "isDeleted": false,
