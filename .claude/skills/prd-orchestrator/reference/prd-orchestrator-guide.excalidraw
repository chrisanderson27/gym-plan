  {
   "type": "rectangle",
   "id": "f_never",
   "x": 90,
   "y": 2610,
   "width": 1990,
   "height": 90,
   "strokeColor": "#b91c1c",
   "backgroundColor": "#fee2e2",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
