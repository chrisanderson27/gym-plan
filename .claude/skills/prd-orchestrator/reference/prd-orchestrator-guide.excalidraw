  {
   "type": "text",
   "id": "d_e2e_t",
   "x": 1350,
   "y": 1145,
   "width": 240,
   "height": 60,
   "text": "4. E2E GATE\ndoes it work in\nthe REAL app?",
   "originalText": "4. E2E GATE\ndoes it work in\nthe REAL app?",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
