  {
   "type": "text",
   "id": "g_cmd_t",
   "x": 2168,
   "y": 2414,
   "width": 1120,
   "height": 105,
   "text": "orchestrator.py resume     # where am I? phase, stage, next action, any GATE-FAILED\norchestrator.py status     # phase table + any one-way deviation recorded so far\norchestrator.py usage      # harvest tokens + enforce the run's $ ceiling\norchestrator.py timeline   # every transition, with durations\norchestrator.py preflight  # can a worker even start here?",
   "originalText": "orchestrator.py resume     # where am I? phase, stage, next action, any GATE-FAILED\norchestrator.py status     # phase table + any one-way deviation recorded so far\norchestrator.py usage      # harvest tokens + enforce the run's $ ceiling\norchestrator.py timeline   # every transition, with durations\norchestrator.py preflight  # can a worker even start here?",
