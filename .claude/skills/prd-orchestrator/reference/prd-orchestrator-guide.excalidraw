  {
   "type": "text",
   "id": "c_q1t",
   "x": 1844,
   "y": 581,
   "width": 590,
   "height": 40,
   "text": "Q1  How far does it run alone?   \u25b8 commit each clean phase\n     option 4 = dry run: show the phase table + gates, then stop",
   "originalText": "Q1  How far does it run alone?   \u25b8 commit each clean phase\n     option 4 = dry run: show the phase table + gates, then stop",
   "fontSize": 12,
   "fontFamily": 3,
