  {
   "type": "text",
   "id": "b_code_t",
   "x": 848,
   "y": 606,
   "width": 570,
   "height": 275,
   "text": "# <your repo>/.claude/orchestrator.toml   \u2014 TRACKED in git\n\n[validation]                 # what the BUILDER runs, not you\nlevels = [\n  { name=\"build\", cmd=\"<your build>\", expect=\"0 errors\" },\n  { name=\"test\",  cmd=\"<your tests>\", expect=\"all pass\" },\n]\n\n[app]                        # delete if you have no runnable app\nstart       = \"<command that starts it>\"\nurl         = \"http://localhost:PORT\"\nready_probe = \"header:Server=Kestrel\"   # NOT just a 200\n\n[knowledge]\nalways_loaded = [\"AGENTS.md\"]   # NEVER auto-committed by a run\n\n[boundary_checks]            # optional architectural fences\ncheck = [{ cmd=\"<prints a count>\", baseline=3 }]",
   "originalText": "# <your repo>/.claude/orchestrator.toml   \u2014 TRACKED in git\n\n[validation]                 # what the BUILDER runs, not you\nlevels = [\n  { name=\"build\", cmd=\"<your build>\", expect=\"0 errors\" },\n  { name=\"test\",  cmd=\"<your tests>\", expect=\"all pass\" },\n]\n\n[app]                        # delete if you have no runnable app\nstart       = \"<command that starts it>\"\nurl         = \"http://localhost:PORT\"\nready_probe = \"header:Server=Kestrel\"   # NOT just a 200\n\n[knowledge]\nalways_loaded = [\"AGENTS.md\"]   # NEVER auto-committed by a run\n\n[boundary_checks]            # optional architectural fences\ncheck = [{ cmd=\"<prints a count>\", baseline=3 }]",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
