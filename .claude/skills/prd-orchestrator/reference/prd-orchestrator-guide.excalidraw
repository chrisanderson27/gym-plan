  {
   "type": "text",
   "id": "e_head",
   "x": 2150,
   "y": 1020,
   "width": 800,
   "height": 28,
   "text": "THE LEDGER \u2014 everything the run knows, on disk",
   "originalText": "THE LEDGER \u2014 everything the run knows, on disk",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
