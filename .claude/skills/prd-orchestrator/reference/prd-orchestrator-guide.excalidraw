  {
   "type": "text",
   "id": "b_t2",
   "x": 130,
   "y": 682,
   "width": 620,
   "height": 25,
   "text": "2.  run the  orchestrator-setup  skill",
   "originalText": "2.  run the  orchestrator-setup  skill",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200015,
