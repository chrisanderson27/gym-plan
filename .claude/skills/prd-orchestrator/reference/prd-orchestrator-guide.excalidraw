  {
   "type": "text",
   "id": "e_sub",
   "x": 2150,
   "y": 1052,
   "width": 1100,
   "height": 55,
   "text": "The orchestrator keeps NO state in its own head. It reads a verdict, writes it here, throws the rest away.\nAfter every phase it harvests exact UTC transcript usage, records it, and checks the run's estimated cost.\nThat is why the $ ceiling can halt before more work starts \u2014 while close-out telemetry still rolls up the whole run.",
   "originalText": "The orchestrator keeps NO state in its own head. It reads a verdict, writes it here, throws the rest away.\nAfter every phase it harvests exact UTC transcript usage, records it, and checks the run's estimated cost.\nThat is why the $ ceiling can halt before more work starts \u2014 while close-out telemetry still rolls up the whole run.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
