  {
   "type": "text",
   "id": "subtitle",
   "x": 60,
   "y": 95,
   "width": 1600,
   "height": 50,
   "text": "A PRD goes in. Committed, reviewed, e2e-tested code comes out \u2014 while you are away.\nYou never write code here. You spawn fresh agents, judge their artifacts, and advance a ledger on disk.",
   "originalText": "A PRD goes in. Committed, reviewed, e2e-tested code comes out \u2014 while you are away.\nYou never write code here. You spawn fresh agents, judge their artifacts, and advance a ledger on disk.",
