  {
   "type": "text",
   "id": "b_t1b",
   "x": 130,
   "y": 616,
   "width": 640,
   "height": 40,
   "text": "install copies the skill family (plan-feature, execute, e2e-test\u2026)\ninto the repo \u2014 the loop calls them by name. Then setup probes\nthe stack and writes a draft config with TODOs.",
   "originalText": "install copies the skill family (plan-feature, execute, e2e-test\u2026)\ninto the repo \u2014 the loop calls them by name. Then setup probes\nthe stack and writes a draft config with TODOs.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
